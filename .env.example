# URL de conexión a PostgreSQL usando el driver psycopg (v3).
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/sin_ruido

# API Key de Google Gemini (usada en fases posteriores, de síntesis con IA).
GEMINI_API_KEY=tu_api_key_aqui

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Alertas de fallo de ingesta (smtplib). Destino ya decidido (nsinruido@gmail.com);
# host/usuario/password son de la cuenta emisora, pendiente de definir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_password_smtp
ALERT_EMAIL_TO=nsinruido@gmail.com

# Vectorización y clustering (Fase 3). Valores calibrados contra noticias reales;
# ver specs/change_logs.md. Se pueden ajustar sin tocar código.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CHARS_CUERPO=500
UMBRAL_SIMILITUD=0.75
HORAS_CLUSTER_ABIERTO=12
MIN_MEDIOS_CLUSTER=2
# Similitud entre centroides para fusionar dos clusters abiertos en uno solo.
UMBRAL_FUSION_CLUSTERS=0.85
# Categorías que no reportan un hecho: no entran al agrupamiento por evento
# pero no se descartan, quedan etiquetadas para su propio circuito. Se busca en
# la URL completa, no en el segmento (un medio publicó un horóscopo bajo
# /tecnologia/). JSON, porque son pares categoría -> patrón.
CATEGORIAS_NO_EVENTO={"horoscopo": "horoscopo|zodiaco|zodiacal|astrolog", "recetas": "receta", "juegos": "loteria|quiniela"}

# Preproceso de evidencia para la síntesis (Fase 4).
# El modelo de spaCy se instala aparte: python -m spacy download es_core_news_md
SPACY_MODEL=es_core_news_md
NER_CHARS_CUERPO=4000
TFIDF_TERMINOS_POR_MEDIO=8
TFIDF_REFIT_RATIO=0.2
# Piso de notas por medio (ningún medio queda afuera) y techo global por cluster.
SINTESIS_NOTAS_POR_MEDIO=2
SINTESIS_MAX_NOTAS=30

# Horas tras las que un cluster deja de ser candidato a sintetizarse. Evita que
# arrancar sobre una base con historia dispare todo el backlog de una. Lo que
# caduca se marca y se avisa por mail: no desaparece en silencio.
HORAS_MAXIMAS_SIN_SINTETIZAR=72

# Síntesis con Gemini (Fase 4).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURA=0.2
# Razonamiento previo: MINIMAL, LOW, MEDIUM o HIGH. Se factura como salida, que
# es la parte cara. Medido: MINIMAL y LOW gastan 0 tokens, MEDIUM 349, HIGH 448.
GEMINI_THINKING_LEVEL=LOW
# Minutos mínimos entre dos avisos del mismo problema, para no inundar el mail.
ALERT_COOLDOWN_MINUTOS=60

# Entrega de las síntesis al back-end por webhook (Fase 4).
# El contrato completo del payload está en specs/webhook_contract.md.
# Sin URL ni secreto la entrega no corre: las síntesis quedan pendientes en la
# base y salen apenas se configura. El secreto es compartido con el back-end y
# nunca viaja por la red — lo que se manda es una firma HMAC derivada de él.
WEBHOOK_URL=https://backend.sinruido.com/webhooks/sintesis
WEBHOOK_SECRET=tu_secreto_compartido
WEBHOOK_TIMEOUT=10.0
# Corridas del barrido tras las que una síntesis deja de reintentarse y se avisa.
WEBHOOK_MAX_INTENTOS=5

# Pool de conexiones (Fase 5). Calibrado contra un solo proceso Uvicorn (el
# Dockerfile corre sin --workers). Razonamiento completo en src/config.py y
# specs/change_logs.md.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
