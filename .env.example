# URL de conexión a PostgreSQL usando el driver psycopg (v3).
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/sin_ruido

# API Key de Google Gemini (usada en fases posteriores, de síntesis con IA).
GEMINI_API_KEY=tu_api_key_aqui

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Alertas de fallo de ingesta (smtplib). Destino ya decidido (nsinruido@gmail.com);
# host/usuario/password son de la cuenta emisora, pendiente de definir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_password_smtp
ALERT_EMAIL_TO=nsinruido@gmail.com

# Vectorización y clustering (Fase 3). Valores calibrados contra noticias reales;
# ver specs/change_logs.md. Se pueden ajustar sin tocar código.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CHARS_CUERPO=500
UMBRAL_SIMILITUD=0.75
HORAS_CLUSTER_ABIERTO=12
MIN_MEDIOS_CLUSTER=2
