# URL de conexión a PostgreSQL usando el driver psycopg (v3).
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/sin_ruido

# --- Modelo de IA que elige el operador (backlog punto 2) --------------------
#
# La síntesis puede correr con el proveedor que elijas —el que pagás, aquel
# donde tenés créditos, o uno local que no manda nada afuera— dándolo de alta
# con `POST /modelos`. Ver specs/roadmap.md, punto 2.
#
# **Es UNA sola variable, y lleva la credencial del proveedor que estés usando
# hoy.** Cambiar de proveedor es cambiar este valor; no se agrega una variable
# por cada uno. El motor la relee en cada llamada, así que el cambio tiene
# efecto sin reiniciar nada. Si también está en el entorno del proceso, gana el
# entorno.
#
# **La key va acá y NUNCA en la base**, que se respalda, se dumpea y se lee
# desde endpoints sin autenticación. La fila del modelo no guarda la key ni
# elige dónde buscarla: solo dice qué modelo es y contra qué `base_url` hablar.
#
# Al activar un modelo el motor **sondea al proveedor de verdad**, porque que
# esta variable exista ya no prueba que tenga adentro la key que corresponde.
#
# Ejemplos de valor, según con quién estés trabajando:
#   sk-...      OpenAI          gsk_...     Groq
#   sk-or-...   OpenRouter      AIza...     Gemini
# Un Ollama local ignora la key, pero la variable tiene que estar igual.
#
# Si venís de una versión anterior: esto **reemplaza a `GEMINI_API_KEY`**.
# Es un renombre, mismo valor. Aquella variable ya no se lee.
# MODELO_API_KEY=

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Detalle de los logs. En INFO se ve qué hizo cada paso del pipeline, con qué
# modelo se sintetizó, cuántos tokens costó y **qué porcentaje del ciclo usó la
# corrida** — que es el número con el que se calibra INGEST_INTERVAL_MINUTES.
# WARNING deja solo los problemas. Un valor mal escrito no impide arrancar: se
# usa INFO y se avisa.
LOG_LEVEL=INFO

# El SQL que ejecuta SQLAlchemy, sentencia por sentencia. Son miles de líneas
# por ciclo, así que va aparte de LOG_LEVEL: se puede poner el motor en DEBUG
# sin que el SQL tape todo lo demás.
LOG_SQL=false

# Token de operador para la API. **Opcional, y la elección es tuya.**
#
# Con esta variable definida, los endpoints piden `Authorization: Bearer <token>`
# —todos menos la salud y la documentación—. Sin ella, la API queda abierta y el
# motor te lo avisa en cada arranque.
#
# Sin token está bien en tu máquina o en una red privada. **Si la exponés, ponelo**:
# los endpoints incluyen uno que gasta plata por invocación (`POST /synthesize`),
# uno que hace al motor golpear todos los feeds con tu identidad (`POST /ingest`)
# y uno que le entrega tu credencial de IA a la URL que le indiquen
# (`POST /modelos`).
#
# Generá uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_TOKEN=

# Alertas de fallo de ingesta (smtplib). Destino ya decidido (nsinruido@gmail.com);
# host/usuario/password son de la cuenta emisora, pendiente de definir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_password_smtp
ALERT_EMAIL_TO=nsinruido@gmail.com

# Vectorización y clustering (Fase 3). Valores calibrados contra noticias reales;
# ver specs/change_logs.md. Se pueden ajustar sin tocar código.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CHARS_CUERPO=500
UMBRAL_SIMILITUD=0.75
HORAS_CLUSTER_ABIERTO=12
MIN_MEDIOS_CLUSTER=2
# Similitud entre centroides para fusionar dos clusters abiertos en uno solo.
UMBRAL_FUSION_CLUSTERS=0.85
# Categorías que no reportan un hecho: no entran al agrupamiento por evento
# pero no se descartan, quedan etiquetadas para su propio circuito. Se busca en
# la URL completa, no en el segmento (un medio publicó un horóscopo bajo
# /tecnologia/). JSON, porque son pares categoría -> patrón.
CATEGORIAS_NO_EVENTO={"horoscopo": "horoscopo|zodiaco|zodiacal|astrolog", "recetas": "receta", "juegos": "loteria|quiniela"}

# Preproceso de evidencia para la síntesis (Fase 4).
# El modelo de spaCy se instala aparte: python -m spacy download es_core_news_md
SPACY_MODEL=es_core_news_md
NER_CHARS_CUERPO=4000
TFIDF_TERMINOS_POR_MEDIO=8
TFIDF_REFIT_RATIO=0.2
# Piso de notas por medio (ningún medio queda afuera) y techo global por cluster.
SINTESIS_NOTAS_POR_MEDIO=2
SINTESIS_MAX_NOTAS=30

# Horas tras las que un cluster deja de ser candidato a sintetizarse. Evita que
# arrancar sobre una base con historia dispare todo el backlog de una. Lo que
# caduca se marca y se avisa por mail: no desaparece en silencio.
HORAS_MAXIMAS_SIN_SINTETIZAR=72

# La síntesis ya no se configura acá: el modelo, su temperatura y su nivel de
# razonamiento viven en la tabla `modelo_ia`, que se administra por
# `GET/POST /modelos` y `PATCH /modelos/{id}`. Ver el bloque MODELO_API_KEY.
#
# Al actualizar desde una versión anterior, la migración `5f80e67d5404` crea
# sola la fila equivalente a lo que tenías configurado acá, pero **la deja
# apagada**: ninguna migración elige proveedor por vos. Mirala con
# `GET /modelos` y prendela con `PATCH /modelos/{id}?activo=true`. Mientras no
# haya ninguna prendida, la síntesis no corre y el motor lo avisa en cada
# corrida.

# Minutos mínimos entre dos avisos del mismo problema, para no inundar el mail.
ALERT_COOLDOWN_MINUTOS=60

# Cada cuánto corre el pipeline completo. Es el único parámetro del scheduler
# que vive acá: los otros (max_instances, coalesce, margen de atraso) son
# estructurales y están en src/main.py. Este se calibra con datos — cada corrida
# loguea qué porcentaje del ciclo usó, y con eso se decide si conviene acortarlo
# para tener noticias más frescas o alargarlo para ganar margen.
INGEST_INTERVAL_MINUTES=15

# Entrega de las síntesis al back-end por webhook (Fase 4).
# El contrato completo del payload está en specs/webhook_contract.md.
# Sin URL ni secreto la entrega no corre: las síntesis quedan pendientes en la
# base y salen apenas se configura. El secreto es compartido con el back-end y
# nunca viaja por la red — lo que se manda es una firma HMAC derivada de él.
WEBHOOK_URL=https://backend.sinruido.com/webhooks/sintesis
WEBHOOK_SECRET=tu_secreto_compartido
WEBHOOK_TIMEOUT=10.0
# Corridas del barrido tras las que una síntesis deja de reintentarse y se avisa.
WEBHOOK_MAX_INTENTOS=5

# Pool de conexiones (Fase 5). Calibrado contra un solo proceso Uvicorn (el
# Dockerfile corre sin --workers). Razonamiento completo en src/config.py y
# specs/change_logs.md.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Extracción del cuerpo desde la URL (backlog post-1.0, punto 1). Segunda vía
# de ingesta para los medios cuyo RSS solo trae un copete. Política de red
# aparte de la de los feeds a propósito: un ciclo baja un feed por medio, pero
# puede pedir decenas de artículos. El porqué de cada número está en
# src/config.py y specs/change_logs.md.
EXTRACCION_TIMEOUT=10.0
EXTRACCION_REINTENTOS=1
# Por debajo de esto lo extraído no se considera un artículo: es la defensa
# contra un rediseño del medio que devuelva un menú en vez de la nota.
EXTRACCION_MIN_CARACTERES=500
# Cortesía, no obligación: ninguno de los dos medios declara crawl-delay.
EXTRACCION_PAUSA_SEGUNDOS=1.0
