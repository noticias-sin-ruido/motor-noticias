# Entornos virtuales
venv/
.venv/

# Cache de Python
__pycache__/
*.py[cod]

# Variables de entorno locales
.env

# Reportes de coverage (mission.md pide 80% mínimo, pero el reporte no se versiona)
.coverage
htmlcov/

# Archivos de SO o editores
.DS_Store
.vscode/
.idea/

# Orquestación (si alguien la crea por error localmente)
docker-compose*.yml

# Configuracion local de Claude Code. La crea `/plugin install` y solo
# registra que plugins tiene habilitados quien trabaja en esta maquina:
# es preferencia de herramienta, no del proyecto.
.claude/
